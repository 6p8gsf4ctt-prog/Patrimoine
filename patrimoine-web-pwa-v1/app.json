{
  "expo": {
    "name": "Mon Patrimoine",
    "slug": "patrimoine-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "patrimoine",
    "userInterfaceStyle": "automatic",
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": {"baseUrl": "/Patrimoine"},
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/icons/icon-192.png"
    },
    "android": {"package": "com.jean.patrimoine"},
    "ios": {"bundleIdentifier": "com.jean.patrimoine"}
  }
}
